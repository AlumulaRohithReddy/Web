          "policyName"
        ],
        "type": "object",
        "properties": {
          "policyId": {
            "type": "integer",
            "format": "int32"
          },
          "policyName": {
            "minLength": 1,
            "type": "string"
          },
          "premium": {
            "type": "number",
            "format": "double"
          },
